{
  "name": "replenish",
  "version": "1.0.0",
  "description": "Replenish weekly focus credits",
  "main": "main.js",
  "author": "Replenish",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.replenish.app",
    "productName": "Replenish",
    "files": [
      "index.html",
